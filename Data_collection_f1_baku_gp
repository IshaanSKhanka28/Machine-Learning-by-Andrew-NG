        "    print(f\"Completed rounds before Baku: {total_rounds}\")\n",
        "\n",
        "    for idx, event in tqdm(\n",
        "        completed.iterrows(), desc=\"2026 rounds\", total=total_rounds\n",
        "    ):\n",
        "        try:\n",
        "            q = fastf1.get_session(2026, event['RoundNumber'], 'Q')\n",
        "            q.load(laps=True, telemetry=False) # Removed results=True\n",
        "\n",
        "            results = q.results\n",
        "\n",
        "            # Get session fastest time\n",
        "            q3_times = results['Q3'].dropna().dt.total_seconds()\n",
        "            q1_times = results['Q1'].dropna().dt.total_seconds()\n",
        "            session_fastest = q3_times.min() \\\n",
        "                if not q3_times.empty else q1_times.min()\n",
        "\n",
        "            # Round weight — more recent rounds weighted higher\n",
        "            # idx+1 because idx is 0-based\n",
        "            round_weight = 0.3 + 0.7 * ((idx + 1) / total_rounds)\n",
        "\n",
        "            for _, drv in results.iterrows():\n",
        "                abbr = drv['Abbreviation']\n",
        "                if abbr not in DRIVERS_2026:\n",
        "                    continue\n",
        "\n",
        "                q3 = drv.get('Q3')\n",
        "                q2 = drv.get('Q2')\n",
        "                q1 = drv.get('Q1')\n",
        "                # Use best available time\n",
        "                best_raw = q3 if pd.notna(q3) else (\n",
        "                    q2 if pd.notna(q2) else q1\n",
        "                )\n",
        "                best_sec = best_raw.total_seconds() \\\n",
        "                    if pd.notna(best_raw) else None\n",
        "                gap = (best_sec - session_fastest) if best_sec else None\n",
        "\n",
        "                season_2026_rows.append({\n",
        "                    'round': event['RoundNumber'],\n",
        "                    'round_weight': round_weight,\n",
        "                    'circuit': event['EventName'],\n",
        "                    'is_street': _is_street(event['EventName']),\n",
        "                    'driver': abbr,\n",
        "                    'team': DRIVERS_2026.get(abbr, 'Unknown'),\n",
        "                    'quali_position': drv['Position'],\n",
        "                    'gap_to_pole': gap,\n",
        "                    'reached_q2': 1 if pd.notna(q2) or pd.notna(q3) else 0,\n",
        "                    'reached_q3': 1 if pd.notna(q3) else 0,\n",
        "                })\n",
        "\n",
        "        except Exception as e:\n",
        "            print(f\"  ✗ 2026 R{event['RoundNumber']}: {e}\")\n",
        "\n",
        "except Exception as e:\n",
        "    print(f\"Schedule pull failed: {e}\")\n",
        "\n",
        "season_2026_df = pd.DataFrame(season_2026_rows)\n",
        "season_2026_df.to_csv('data/raw/season_2026_quali.csv', index=False)\n",
        "print(f\"Saved: {len(season_2026_df)} rows\")\n",
        "print(season_2026_df.groupby('driver')['quali_position'].mean().sort_values())"
