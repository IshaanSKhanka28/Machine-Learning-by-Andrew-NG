      "cell_type": "code",
      "source": [
        "print(\"=\" * 50)\n",
        "print(\"SECTION 1: Baku Qualifying History\")\n",
        "print(\"=\" * 50)\n",
        "\n",
        "baku_quali_rows = []\n",
        "\n",
        "for year in tqdm(BAKU_YEARS, desc=\"Baku quali years\"):\n",
        "    try:\n",
        "        session = fastf1.get_session(year, _session_name(year), 'Q')\n",
        "        session.load(laps=True, telemetry=False) # Removed results=True\n",
        "\n",
        "        results = session.results\n",
        "        laps = session.laps\n",
        "\n",
        "        # Session pole time (fastest Q3 lap of the session)\n",
        "        all_times = laps.groupby(\n",
        "            'Driver')['LapTime'].min().dt.total_seconds()\n",
        "        session_fastest = all_times.min()\n",
        "\n",
        "        for _, drv in results.iterrows():\n",
        "            abbr = drv['Abbreviation']\n",
        "\n",
        "            # Only collect data for drivers on the 2026 grid\n",
        "            if abbr not in DRIVERS_2026:\n",
        "                continue\n",
        "\n",
        "            # Extract Q1/Q2/Q3 times in seconds\n",
        "            q1 = drv.get('Q1')\n",
        "            q2 = drv.get('Q2')\n",
        "            q3 = drv.get('Q3')\n",
        "            q1s = q1.total_seconds() if pd.notna(q1) else None\n",
        "            q2s = q2.total_seconds() if pd.notna(q2) else None\n",
        "            q3s = q3.total_seconds() if pd.notna(q3) else None\n",
        "\n",
        "            best = min(\n",
        "                [t for t in [q1s, q2s, q3s] if t is not None],\n",
        "                default=None\n",
        "            )\n",
        "            gap = (best - session_fastest) if best else None\n",
        "\n",
        "            baku_quali_rows.append({\n",
        "                'year': year,\n",
        "                'driver': abbr,\n",
        "                'team_that_year': drv['TeamName'],\n",
        "                'current_team_2026': DRIVERS_2026[abbr],\n",
        "                'quali_position': drv['Position'],\n",
        "                'q1_time': q1s,\n",
        "                'q2_time': q2s,\n",
        "                'q3_time': q3s,\n",
        "                'best_time': best,\n",
        "                'gap_to_pole': gap,\n",
        "                'session_fastest': session_fastest,\n",
        "                'reached_q2': 1 if q2s else 0,\n",
        "                'reached_q3': 1 if q3s else 0,\n",
        "                'year_weight': YEAR_WEIGHTS[year],\n",
        "                'reg_era': _get_reg_era(year),\n",
        "            })\n",
        "\n",
        "    except Exception as e:\n",
        "        print(f\"  ✗ Baku quali {year}: {e}\")\n",
        "\n",
        "baku_quali_df = pd.DataFrame(baku_quali_rows)\n",
        "baku_quali_df.to_csv('data/raw/baku_quali_history.csv', index=False)\n",
        "print(f\"Saved: {len(baku_quali_df)} rows\")\n",
        "print(baku_quali_df.groupby('driver')['gap_to_pole'].mean().sort_values())"
      ],
