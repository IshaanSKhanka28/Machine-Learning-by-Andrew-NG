        "# ── 2026 Grid Definition ─────────────────────────────────────────\n",
        "# 22 drivers, 11 teams — confirmed 2026 lineup\n",
        "DRIVERS_2026 = {\n",
        "    'NOR': 'McLaren',    'PIA': 'McLaren',\n",
        "    'RUS': 'Mercedes',   'ANT': 'Mercedes',\n",
        "    'HAM': 'Ferrari',    'LEC': 'Ferrari',\n",
        "    'VER': 'Red Bull',   'HAD': 'Red Bull',\n",
        "    'ALB': 'Williams',   'SAI': 'Williams',\n",
        "    'LAW': 'Racing Bulls','LIN': 'Racing Bulls',\n",
        "    'ALO': 'Aston Martin','STR': 'Aston Martin',\n",
        "    'HUL': 'Audi',       'BOR': 'Audi',\n",
        "    'GAS': 'Alpine',     'COL': 'Alpine',\n",
        "    'BEA': 'Haas',       'OCO': 'Haas',\n",
        "    'BOT': 'Cadillac',   'PER': 'Cadillac',\n",
        "}\n",
        "\n",
        "# Drivers with no or very limited F1 history before 2025\n",
        "ROOKIES_2026 = {'LIN'}\n",
        "LIMITED_HISTORY = {'ANT', 'HAD', 'BOR', 'COL'}\n",
        "\n",
        "# Baku has been on calendar since 2016 (skipped 2020 COVID)\n",
        "BAKU_YEARS = [2016, 2017, 2018, 2019, 2021, 2022, 2023, 2024, 2025]\n",
        "\n",
        "# Year weights — more recent = higher weight\n",
        "YEAR_WEIGHTS = {\n",
        "    2016: 0.20, 2017: 0.25, 2018: 0.30,\n",
        "    2019: 0.35, 2021: 0.45, 2022: 0.55,\n",
        "    2023: 0.70, 2024: 0.85, 2025: 1.00,\n",
        "}\n"
      ],
