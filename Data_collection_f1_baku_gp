        "print(\"\\n\" + \"=\" * 50)\n",
        "print(\"SECTION 3: Baku Race History\")\n",
        "print(\"=\" * 50)\n",
        "\n",
        "baku_race_rows = []\n",
        "\n",
        "for year in tqdm(BAKU_YEARS, desc=\"Baku race years\"):\n",
        "    try:\n",
        "        session = fastf1.get_session(year, _session_name(year), 'R')\n",
        "        session.load(telemetry=False) # Removed results=True\n",
        "\n",
        "        for _, drv in session.results.iterrows():\n",
        "            abbr = drv['Abbreviation']\n",
        "            if abbr not in DRIVERS_2026:\n",
        "                continue\n",
        "\n",
        "            status = str(drv['Status'])\n",
        "            dnf = 0 if ('Finished' in status or '+' in status) else 1\n",
        "\n",
        "            baku_race_rows.append({\n",
        "                'year': year,\n",
        "                'driver': abbr,\n",
        "                'finish_position': drv['Position'],\n",
        "                'status': status,\n",
        "                'dnf': dnf,\n",
        "                'year_weight': YEAR_WEIGHTS[year],\n",
        "            })\n",
        "\n",
        "    except Exception as e:\n",
        "        print(f\"  ✗ Baku race {year}: {e}\")\n",
        "\n",
        "baku_race_df = pd.DataFrame(baku_race_rows)\n",
        "baku_race_df.to_csv('data/raw/baku_race_history.csv', index=False)\n",
        "print(f\"Saved: {len(baku_race_df)} rows\")\n",
        "print(f\"Overall Baku DNF rate: {baku_race_df['dnf'].mean():.2%}\")"
