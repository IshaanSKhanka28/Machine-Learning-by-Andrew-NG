    {
      "cell_type": "code",
      "source": [
        "def _session_name(year):\n",
        "# 2016 was called European GP, renamed Azerbaijan GP after\n",
        "    return 'European Grand Prix' if year == 2016 else 'Azerbaijan'\n",
        "\n",
        "def _get_reg_era(year):\n",
        "    # Different regulation eras affect car performance characteristics\n",
        "    if year <= 2016: return 0   # pre-2017 regs\n",
        "    if year <= 2021: return 1   # 2017-2021 regs\n",
        "    if year <= 2025: return 2   # 2022 ground effect regs\n",
        "    return 3                    # 2026 new PU + aero regs\n",
        "\n",
        "def _is_street(circuit_name):\n",
        "    streets = ['Monaco', 'Singapore', 'Baku', 'Jeddah',\n",
        "               'Miami', 'Las Vegas', 'Azerbaijan']\n",
        "    return 1 if any(s in circuit_name for s in streets) else 0\n"
      ],
